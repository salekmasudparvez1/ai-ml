    "import matplotlib.pyplot as plt \n",
    "days = [1,2,3,4,5]\n",
    "temperature = [30,32,31,29,35]\n",
    "plt.plot(days, temperature)\n",
    "\n",
    "\n",
    "plt.xticks ([1,2,3,4,5])\n",
    "\n",
    "plt.title(\"Temperature Trend\")\n",
    "plt.xlabel(\"Day\")\n",
    "plt.ylabel(\"Temperature\")\n",
    "plt.show()"
   ]
